{
    "name": "@terncosoftware/vaults",
    "version": "0.1.0",
    "type": "module",
    "exports": {
        ".": {
            "source": "./src/index.ts",
            "default": "./dist/index.js",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/terncosoftware/system.git",
        "directory": "packages/vaults"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "public"
    },
    "scripts": {
        "build": "yarn compile",
        "compile": "tsc -b",
        "clean": "rm -rf dist && rm -f tsconfig.tsbuildinfo",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@azure/identity": "^4.4.1",
        "@azure/keyvault-secrets": "^4.8.0",
        "@terncosoftware/core": "workspace:^"
    },
    "devDependencies": {
        "@types/node": "^22.0.0"
    }
}
