{
    "name": "@terncosoftware/data",
    "version": "0.2.0",
    "type": "module",
    "exports": {
        ".": {
            "source": "./src/index.ts",
            "default": "./dist/index.js",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/terncosoftware/system.git",
        "directory": "packages/data"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "public"
    },
    "scripts": {
        "build": "yarn compile",
        "compile": "tsc -b",
        "clean": "rm -rf dist && rm -f tsconfig.tsbuildinfo",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@terncosoftware/core": "workspace:^",
        "knex": "^3.1.0"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.12",
        "better-sqlite3": "^11.10.0"
    },
    "peerDependencies": {
        "better-sqlite3": "^11.0.0",
        "pg": "^8.0.0"
    },
    "peerDependenciesMeta": {
        "pg": {
            "optional": true
        }
    }
}
