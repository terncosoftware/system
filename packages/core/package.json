{
    "name": "@terncosoftware/core",
    "version": "0.1.0",
    "type": "module",
    "exports": {
        ".": {
            "browser": "./dist/browser.js",
            "source": "./src/index.ts",
            "default": "./dist/index.js",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./tenancy": {
            "source": "./src/tenancy/index.ts",
            "default": "./dist/tenancy/index.js",
            "types": "./dist/tenancy/index.d.ts",
            "import": "./dist/tenancy/index.js"
        },
        "./licensing": {
            "source": "./src/licensing/index.ts",
            "default": "./dist/licensing/index.js",
            "types": "./dist/licensing/index.d.ts",
            "import": "./dist/licensing/index.js"
        },
        "./list": {
            "source": "./src/list/index.ts",
            "default": "./dist/list/index.js",
            "types": "./dist/list/index.d.ts",
            "import": "./dist/list/index.js"
        },
        "./topics": {
            "source": "./src/topics/index.ts",
            "default": "./dist/topics/index.js",
            "types": "./dist/topics/index.d.ts",
            "import": "./dist/topics/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "ontology"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/terncosoftware/system.git",
        "directory": "packages/core"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "public"
    },
    "scripts": {
        "build": "yarn compile",
        "gen": "tern-codegen",
        "gen:watch": "tern-codegen --watch",
        "compile": "tsc -b",
        "clean": "rm -rf dist && rm tsconfig.tsbuildinfo",
        "start": "node dist/index.js",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "watch": "tsc -b -w"
    },
    "dependencies": {
        "reflect-metadata": "^0.1.14",
        "typescript-ioc": "^3.2.2"
    },
    "devDependencies": {
        "@terncosoftware/gen": "workspace:^"
    },
    "tern": {
        "extension": "urn:sys:core",
        "requires": [],
        "targets": [
            {
                "name": "auth",
                "extensions": [
                    "./ontology/auth.ttl"
                ],
                "shapes": [
                    "./ontology/auth.shacl.ttl"
                ],
                "localNamespace": "urn:sys:core:auth:",
                "iriImport": "../semantics/IRI.js",
                "out": "./src/auth/types.generated.ts"
            },
            {
                "name": "rbac",
                "extensions": [
                    "./ontology/rbac.ttl"
                ],
                "shapes": [
                    "./ontology/rbac.shacl.ttl"
                ],
                "localNamespace": "urn:sys:core:rbac:",
                "iriImport": "../semantics/IRI.js",
                "out": "./src/rbac/types.generated.ts"
            },
            {
                "name": "tenancy",
                "bases": [
                    {
                        "ontology": "./ontology/auth.ttl",
                        "package": "../auth/types.generated.js"
                    },
                    {
                        "ontology": "./ontology/licensing.ttl",
                        "package": "../licensing/types.generated.js"
                    }
                ],
                "extensions": [
                    "./ontology/tenancy.ttl"
                ],
                "shapes": [],
                "localNamespace": "urn:sys:core:tenancy:",
                "iriImport": "../semantics/IRI.js",
                "out": "./src/tenancy/types.generated.ts"
            },
            {
                "name": "licensing",
                "extensions": [
                    "./ontology/licensing.ttl"
                ],
                "shapes": [
                    "./ontology/licensing.shacl.ttl"
                ],
                "localNamespace": "urn:sys:core:licensing:",
                "iriImport": "../semantics/IRI.js",
                "out": "./src/licensing/types.generated.ts"
            },
            {
                "name": "superuser",
                "bases": [
                    {
                        "ontology": "./ontology/auth.ttl",
                        "package": "../auth/types.generated.js"
                    }
                ],
                "extensions": [
                    "./ontology/superuser.ttl"
                ],
                "shapes": [
                    "./ontology/superuser.shacl.ttl"
                ],
                "localNamespace": "urn:sys:core:superuser:",
                "iriImport": "../semantics/IRI.js",
                "out": "./src/superuser/types.generated.ts"
            },
            {
                "name": "core",
                "extensions": [
                    "./ontology/core.ttl"
                ],
                "shapes": [],
                "localNamespace": "urn:sys:core:core:",
                "iriImport": "../semantics/IRI.js",
                "out": "./src/core/types.generated.ts"
            }
        ]
    }
}
